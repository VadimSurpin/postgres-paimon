-- dropping a schema emits drop_table only, no per-column messages
CREATE SCHEMA s4;
CREATE TABLE s4.t (id int PRIMARY KEY, a int, b int);
SELECT paimon.add_table('s4.t'::regclass);
 add_table 
-----------
 
(1 row)

SELECT paimon.peek_messages() - 'relid';
                                                                                                                         ?column?                                                                                                                          
-----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"v": 1, "op": "create", "pk": ["id"], "cols": [{"id": 1, "name": "id", "type": "INT NOT NULL"}, {"id": 2, "name": "a", "type": "INT"}, {"id": 3, "name": "b", "type": "INT"}], "table": "t", "schema": "s4", "options": {"changelog-producer": "input"}}
(1 row)

DROP SCHEMA s4 CASCADE;
NOTICE:  drop cascades to table s4.t
SELECT paimon.peek_messages() - 'relid';
                          ?column?                          
------------------------------------------------------------
 {"v": 1, "op": "drop_table", "table": "t", "schema": "s4"}
(1 row)

