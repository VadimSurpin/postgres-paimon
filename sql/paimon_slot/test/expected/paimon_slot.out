-------------+------------+---------+--------------+------------------+--------------------
 public      | reg_t      | {id}    | t            | full             | input
(1 row)

SELECT relreplident FROM pg_class WHERE oid = 'reg_t'::regclass;
 relreplident 
--------------
 f
(1 row)

SELECT count(*) FROM pg_publication_tables
WHERE pubname = 'paimon_pub' AND tablename = 'reg_t';
