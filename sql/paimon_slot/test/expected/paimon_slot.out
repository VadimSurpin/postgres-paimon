-- (8) the publication cannot be changed in a way that silently stops changes
CREATE TABLE pub_t (id int PRIMARY KEY, a int, b text);
SELECT paimon.add_table('pub_t'::regclass);
 add_table 
-----------
 
(1 row)

ALTER PUBLICATION paimon_pub DROP TABLE pub_t;                                  -- expect ERROR
ERROR:  paimon_slot: this change to the publication would silently stop changes reaching Paimon: replicated table public.pub_t is not in publication paimon_pub
HINT:  paimon_pub is managed by paimon.add_table() and paimon.remove_table(); it must publish every action of every replicated table, with no row filter or column list. To stop replicating a table use paimon.remove_table()
ALTER PUBLICATION paimon_pub SET (publish = 'insert');                          -- expect ERROR
ERROR:  paimon_slot: this change to the publication would silently stop changes reaching Paimon: publication paimon_pub does not publish every action (publish must be 'insert, update, delete, truncate')
HINT:  paimon_pub is managed by paimon.add_table() and paimon.remove_table(); it must publish every action of every replicated table, with no row filter or column list. To stop replicating a table use paimon.remove_table()
ALTER PUBLICATION paimon_pub SET (publish = 'insert, update, delete');          -- expect ERROR
ERROR:  paimon_slot: this change to the publication would silently stop changes reaching Paimon: publication paimon_pub does not publish every action (publish must be 'insert, update, delete, truncate')
HINT:  paimon_pub is managed by paimon.add_table() and paimon.remove_table(); it must publish every action of every replicated table, with no row filter or column list. To stop replicating a table use paimon.remove_table()
ALTER PUBLICATION paimon_pub SET (publish_via_partition_root = true);           -- expect ERROR
ERROR:  paimon_slot: this change to the publication would silently stop changes reaching Paimon: publication paimon_pub has publish_via_partition_root = true
HINT:  paimon_pub is managed by paimon.add_table() and paimon.remove_table(); it must publish every action of every replicated table, with no row filter or column list. To stop replicating a table use paimon.remove_table()
-- SET TABLE restating every replicated table, with pub_t given a column list, a row filter,
-- or neither (the last is a no-op restatement, and allowed)
CREATE FUNCTION pg_temp.restate(pub_t_spec text) RETURNS void LANGUAGE plpgsql AS $$
BEGIN
    EXECUTE 'ALTER PUBLICATION paimon_pub SET TABLE '
        || (SELECT string_agg(CASE WHEN relid = 'pub_t'::regclass THEN pub_t_spec
                                   ELSE 'ONLY ' || relid::regclass::text END, ', ')
              FROM paimon.table_registry);
END $$;
SELECT pg_temp.restate('ONLY pub_t (id, a)');                                   -- expect ERROR
ERROR:  paimon_slot: this change to the publication would silently stop changes reaching Paimon: replicated table public.pub_t has a column list in publication paimon_pub
HINT:  paimon_pub is managed by paimon.add_table() and paimon.remove_table(); it must publish every action of every replicated table, with no row filter or column list. To stop replicating a table use paimon.remove_table()
SELECT pg_temp.restate('ONLY pub_t WHERE (a > 0)');                             -- expect ERROR
ERROR:  paimon_slot: this change to the publication would silently stop changes reaching Paimon: replicated table public.pub_t has a row filter in publication paimon_pub
HINT:  paimon_pub is managed by paimon.add_table() and paimon.remove_table(); it must publish every action of every replicated table, with no row filter or column list. To stop replicating a table use paimon.remove_table()
SELECT pg_temp.restate('ONLY pub_t');
 restate 
---------
 
(1 row)

ALTER PUBLICATION paimon_pub RENAME TO renamed_pub;                             -- expect ERROR
ERROR:  paimon_slot: this change to the publication would silently stop changes reaching Paimon: publication paimon_pub does not exist (dropped or renamed)
HINT:  paimon_pub is managed by paimon.add_table() and paimon.remove_table(); it must publish every action of every replicated table, with no row filter or column list. To stop replicating a table use paimon.remove_table()
DROP PUBLICATION paimon_pub;                                                    -- expect ERROR
ERROR:  paimon_slot: this change to the publication would silently stop changes reaching Paimon: publication paimon_pub does not exist (dropped or renamed)
HINT:  paimon_pub is managed by paimon.add_table() and paimon.remove_table(); it must publish every action of every replicated table, with no row filter or column list. To stop replicating a table use paimon.remove_table()
-- the neighbours: an untracked table may come and go, the owner may change
