-- (6) inheritance and partitions
CREATE TABLE ih_par (id int PRIMARY KEY, v text);
SELECT paimon.add_table('ih_par'::regclass);
 add_table 
-----------
 
(1 row)

CREATE TABLE ih_child () INHERITS (ih_par);                                     -- expect ERROR
ERROR:  paimon_slot: public.ih_par has inheritance child public.ih_child and cannot be replicated
HINT:  rows of an inheritance child belong to the child: they would not reach the parent's Paimon table although SELECT on the parent returns them; replicate each table separately (paimon.add_table on each), with no inheritance between replicated tables
CREATE TABLE ih_other (id int PRIMARY KEY, v text);
ALTER TABLE ih_other INHERIT ih_par;                                            -- expect ERROR
ERROR:  paimon_slot: public.ih_par has inheritance child public.ih_other and cannot be replicated
HINT:  rows of an inheritance child belong to the child: they would not reach the parent's Paimon table although SELECT on the parent returns them; replicate each table separately (paimon.add_table on each), with no inheritance between replicated tables
CREATE TABLE ih_p2 (id int PRIMARY KEY, v text);
CREATE TABLE ih_c2 () INHERITS (ih_p2);
SELECT paimon.add_table('ih_p2'::regclass);                                     -- expect ERROR
ERROR:  paimon_slot: public.ih_p2 has inheritance child public.ih_c2 and cannot be replicated
HINT:  rows of an inheritance child belong to the child: they would not reach the parent's Paimon table although SELECT on the parent returns them; replicate each table separately (paimon.add_table on each), with no inheritance between replicated tables
-- a replicated CHILD is fine, and its parent's ALTER now reaches its registry
