  FROM (VALUES (NULL::numeric), (0), (1), (1073741824), (1073741825), (10737418240),
               (68719476736), (68719476737), (1e15)) v(b);
        b         | buckets 
------------------+---------
                  |       1
                0 |       1
                1 |       1
       1073741824 |       1
       1073741825 |       2
      10737418240 |      10
      68719476736 |      64
      68719476737 |      64
 1000000000000000 |      64
(9 rows)

