ALTER TABLE ddl_t ALTER COLUMN n TYPE bigint;
SELECT paimon.peek_messages() - 'relid';
                                ?column?                                 
-------------------------------------------------------------------------
 {"v": 1, "op": "add_col", "col": {"id": 4, "name": "n", "type": "INT"}}
 {"v": 1, "id": 4, "op": "alter_col", "name": "n", "type": "BIGINT"}
(2 rows)

ALTER TABLE ddl_t DROP COLUMN n;
SELECT paimon.peek_messages() - 'relid';
                ?column?                 
-----------------------------------------
 {"v": 1, "op": "drop_col", "name": "n"}
(1 row)

ALTER TABLE ddl_t DROP COLUMN renamed;
SELECT paimon.peek_messages() - 'relid';
                   ?column?                    
-----------------------------------------------
 {"v": 1, "op": "drop_col", "name": "renamed"}
(1 row)

