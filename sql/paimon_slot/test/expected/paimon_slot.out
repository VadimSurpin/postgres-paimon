-- (4) names Paimon or the warehouse cannot take
CREATE TABLE "id$x" (id int PRIMARY KEY);
CREATE TABLE "id:x" (id int PRIMARY KEY);
CREATE TABLE "id/x" (id int PRIMARY KEY);
CREATE TABLE "." (id int PRIMARY KEY);
CREATE TABLE ".." (id int PRIMARY KEY);
CREATE SCHEMA sys;
CREATE TABLE sys.t (id int PRIMARY KEY);
CREATE SCHEMA "s:x";
CREATE TABLE "s:x".t (id int PRIMARY KEY);
SELECT paimon.add_table('"id$x"'::regclass);                                    -- expect ERROR
ERROR:  paimon_slot: table name "id$x" cannot be a Paimon table name
HINT:  Paimon reads "$" as a system-table suffix, ":" as a URI scheme, and "/", "." and ".." as paths in the warehouse; rename the table before paimon.add_table() (a later RENAME TO does not change the Paimon name)
