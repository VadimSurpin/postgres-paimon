-- a guard cannot be dropped, renamed, or replaced by a same-named constraint
ALTER TABLE vg_t DROP CONSTRAINT paimon_guard_2;                                -- expect ERROR
ERROR:  paimon_slot: constraint "paimon_guard_2" on public.vg_t is the value guard of column "n" and must stay while the table is replicated
HINT:  it keeps values Paimon cannot represent (numeric NaN, a timestamp after 294247-01-10 04:00:54.775807) out of the replication stream, where one would stop replication for good; paimon.remove_table() drops it
ALTER TABLE vg_t RENAME CONSTRAINT paimon_guard_3 TO mine;                      -- expect ERROR
ERROR:  paimon_slot: constraint "paimon_guard_3" on public.vg_t is the value guard of column "ts" and must stay while the table is replicated
HINT:  it keeps values Paimon cannot represent (numeric NaN, a timestamp after 294247-01-10 04:00:54.775807) out of the replication stream, where one would stop replication for good; paimon.remove_table() drops it
ALTER TABLE vg_t DROP CONSTRAINT paimon_guard_4,
  ADD CONSTRAINT paimon_guard_4 CHECK (true);                                   -- expect ERROR
ERROR:  paimon_slot: constraint "paimon_guard_4" on public.vg_t is the value guard of column "tz" and must stay while the table is replicated
HINT:  it keeps values Paimon cannot represent (numeric NaN, a timestamp after 294247-01-10 04:00:54.775807) out of the replication stream, where one would stop replication for good; paimon.remove_table() drops it
