-- combined actions are judged on the statement's net effect
CREATE TABLE combo_t (id int PRIMARY KEY, b int, y int, w int, x int, k int);
SELECT paimon.add_table('combo_t'::regclass);
 add_table 
-----------
 
(1 row)

SELECT paimon.peek_messages() - 'relid';
                                                                                                                                                                                                                                     ?column?                                                                                                                                                                                                                                     
----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 {"v": 1, "op": "create", "pk": ["id"], "cols": [{"id": 1, "name": "id", "type": "INT NOT NULL"}, {"id": 2, "name": "b", "type": "INT"}, {"id": 3, "name": "y", "type": "INT"}, {"id": 4, "name": "w", "type": "INT"}, {"id": 5, "name": "x", "type": "INT"}, {"id": 6, "name": "k", "type": "INT"}], "table": "combo_t", "schema": "public", "options": {"bucket": 4, "hist-table": "combo_t_hist", "hist-bucket": 4, "hist-bucket-user": false, "changelog-producer": "input"}}
(1 row)

