-- the create message reached the slot
SELECT (j->>'op') AS op, (j->>'table') AS tbl, (j->'cols'->0->>'name') AS first_col
FROM (SELECT paimon.peek_messages() AS j) s;
   op   |  tbl  | first_col 
--------+-------+-----------
 create | reg_t | id
(1 row)

