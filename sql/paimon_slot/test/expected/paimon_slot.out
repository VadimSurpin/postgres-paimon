-- the guardrails apply to it as to any table
ALTER TABLE kl_t REPLICA IDENTITY DEFAULT;                                      -- expect ERROR
ERROR:  paimon_slot: replica identity of a replicated table must stay FULL
HINT:  the writer needs the complete old row; see design spec section 5
ALTER TABLE kl_t ADD COLUMN d int DEFAULT 1;                                    -- expect ERROR
ERROR:  paimon_slot: ADD COLUMN with a DEFAULT is not supported (public.kl_t.d)
HINT:  add the column without a default, then UPDATE it
ALTER TABLE kl_t ADD PRIMARY KEY (b);                                           -- expect ERROR
ERROR:  paimon_slot: cannot change the primary key of public.kl_t
HINT:  the Paimon table key is fixed at add_table() time
-- the log's own field names are reserved on a key-less table, and only there
ALTER TABLE kl_t ADD COLUMN _lsn int;                                           -- expect ERROR
ERROR:  paimon_slot: column name "_lsn" is a metadata field of the history table every replicated table has
HINT:  choose a different column name; _op, _commit_lsn, _lsn, _op_seq, _xid, _ts and _dt are the history table's own fields
ALTER TABLE kl_t RENAME COLUMN a TO _op;                                        -- expect ERROR
ERROR:  paimon_slot: column name "_op" is a metadata field of the history table every replicated table has
HINT:  choose a different column name; _op, _commit_lsn, _lsn, _op_seq, _xid, _ts and _dt are the history table's own fields
ALTER TABLE kl_t ADD COLUMN _ts timestamptz;                                    -- expect ERROR
ERROR:  paimon_slot: column name "_ts" is a metadata field of the history table every replicated table has
HINT:  choose a different column name; _op, _commit_lsn, _lsn, _op_seq, _xid, _ts and _dt are the history table's own fields
ALTER TABLE kl_t ADD COLUMN _commit_lsn bigint;                                 -- expect ERROR
ERROR:  paimon_slot: column name "_commit_lsn" is a metadata field of the history table every replicated table has
HINT:  choose a different column name; _op, _commit_lsn, _lsn, _op_seq, _xid, _ts and _dt are the history table's own fields
