SELECT count(*) FROM paimon.table_registry WHERE relid = 'reg_t'::regclass;
 count 
-------
     0
(1 row)

SELECT count(*) FROM pg_publication_tables
WHERE pubname = 'paimon_pub' AND tablename = 'reg_t';
 count 
-------
