SELECT * FROM paimon.health();
                                                                                        health                                                                                        
--------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
 event trigger paimon_ddl_end is not ENABLE ALWAYS: DDL on replicated tables is not checked or replicated while it does not fire (ALTER EVENT TRIGGER paimon_ddl_end ENABLE ALWAYS)
 event trigger paimon_sql_drop is not ENABLE ALWAYS: DDL on replicated tables is not checked or replicated while it does not fire (ALTER EVENT TRIGGER paimon_sql_drop ENABLE ALWAYS)
(2 rows)

