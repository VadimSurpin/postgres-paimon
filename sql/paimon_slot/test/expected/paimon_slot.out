 {"v": 1, "op": "drop_table", "table": "ddl_t", "schema": "public"}
(1 row)

SELECT count(*) FROM paimon.table_registry WHERE relid IS NOT NULL
  AND table_name = 'ddl_t';
 count 
-------
     0
(1 row)

